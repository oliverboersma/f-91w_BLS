(version 1)
(rule "copper to board edge 0.3 mm (JLC flex laser outline), except the FFC gold fingers"
  (condition "!(A.Type == 'Pad' && A.memberOfFootprint('J1')) && !(B.Type == 'Pad' && B.memberOfFootprint('J1'))")
  (constraint edge_clearance (min 0.3mm)))

(rule "FFC gold fingers: JLC minimum 0.20 mm edge setback"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('J1')")
  (constraint edge_clearance (min 0.2mm)))
