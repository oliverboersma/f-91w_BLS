  (gr_text "F-91W PPG flex rev B" (at 148.3 103.2) (layer "F.SilkS") (tstamp 02717cdb-1be0-4a0e-b76b-b6a995bf59f6)
    (effects (font (size 0.6 0.6) (thickness 0.09)))
  )
  (gr_text "FOLD SECTION 14.0 mm: no stiffener, no pour, B.Cu traces only.\nFolded by hand at install, plain side (F) inside both folds:\n1) back over J1   2) around the 6 o'clock board edge   3) step down into the bowl.\nBend radius >= 0.4 mm; keep bends >= 1 mm from the body." (at 158 108.62) (layer "Dwgs.User") (tstamp 1faa4ad1-7d43-4e3d-8259-303dfa2f5987)
    (effects (font (size 0.6 0.6) (thickness 0.075)) (justify left))
  )
  (gr_text "fold 2 (6 o'clock edge), approx." (at 149.9363 114.346) (layer "Dwgs.User") (tstamp 5f8b5092-691e-4be8-b48a-78f21804ca69)
    (effects (font (size 0.5 0.5) (thickness 0.075)) (justify right))
  )
  (gr_text "STIFFENER 2: 0.1 mm polyimide (0.2 mm FR4 if height allows), F side, behind U2" (at 148.4 85.7611) (layer "Dwgs.User") (tstamp 71fb0873-b7f4-4d09-a661-892da124fe8a)
    (effects (font (size 0.5 0.5) (thickness 0.075)))
